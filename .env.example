# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# Speechmatics real-time API key.
# Create one at https://portal.speechmatics.com/manage-access/
# Used ONLY on the server, to mint short-lived browser JWTs. It is never sent
# to the client. Leave unset to run the app with typed commands only.
SPEECHMATICS_API_KEY=
